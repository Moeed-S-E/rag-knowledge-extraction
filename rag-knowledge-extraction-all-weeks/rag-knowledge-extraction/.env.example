# Optional OpenAI-compatible provider settings. Leave blank for offline extractive answers.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324
LLM_TIMEOUT_SECONDS=30

# Local paths
RAG_RAW_DATA=data/raw/documents.jsonl
RAG_CLEAN_DATA=data/processed/clean_documents.jsonl
RAG_INDEX_DIR=artifacts/index
RAG_LOG_FILE=logs/rag_requests.jsonl
